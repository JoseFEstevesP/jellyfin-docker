COMPOSE_PROJECT_NAME=jellyfin
TZ=Etc/UTC
PUID=1000
PGID=1000
RENDER_GID=105
RENDER_DEVICE=/dev/dri/renderD128
MEDIA_ROOT_PATH=/absolute/path/to/media
MEDIA_PATH=/absolute/path/to/media/series
MOVIES_PATH=/absolute/path/to/media/peliculas
DOWNLOADS_PATH=/absolute/path/to/media/torrents
JELLYFIN_IMAGE=jellyfin/jellyfin:10.11.11
JELLYFIN_HTTP_BIND_ADDRESS=127.0.0.1
JELLYFIN_HTTP_PORT=8096
JELLYFIN_DISCOVERY_BIND_ADDRESS=127.0.0.1
JELLYFIN_DISCOVERY_PORT=7359
JELLYFIN_PUBLISHED_SERVER_URL=
DOMAIN_NAME=
PROWLARR_IMAGE=lscr.io/linuxserver/prowlarr:2.6.5
SONARR_IMAGE=lscr.io/linuxserver/sonarr:4.0.20
RADARR_IMAGE=lscr.io/linuxserver/radarr:6.4.4
QBITTORRENT_IMAGE=lscr.io/linuxserver/qbittorrent:5.2.4
SEERR_IMAGE=ghcr.io/seerr-team/seerr:v3.5.0
PROWLARR_HTTP_BIND_ADDRESS=127.0.0.1
PROWLARR_HTTP_PORT=9696
SONARR_HTTP_BIND_ADDRESS=127.0.0.1
SONARR_HTTP_PORT=8989
RADARR_HTTP_BIND_ADDRESS=127.0.0.1
RADARR_HTTP_PORT=7878
QBITTORRENT_HTTP_BIND_ADDRESS=127.0.0.1
QBITTORRENT_HTTP_PORT=8080
SEERR_HTTP_BIND_ADDRESS=127.0.0.1
SEERR_HTTP_PORT=5055
PROWLARR_MEM_LIMIT=256m
SONARR_MEM_LIMIT=384m
RADARR_MEM_LIMIT=384m
QBITTORRENT_MEM_LIMIT=256m
SEERR_MEM_LIMIT=512m
